{
  "name": "s2j-cozy-brew",
  "version": "1.0.11",
  "description": "Using SwiftUI, reimplement the AppKit-based \"Cakebrew\".",
  "type": "module",
  "author": "Koutarou ISHIKAWA",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stein2nd/s2j-cozy-brew.git"
  },
  "homepage": "https://github.com/stein2nd/s2j-cozy-brew#readme",
  "bugs": {
    "url": "https://github.com/stein2nd/s2j-cozy-brew/issues"
  },
  "keywords": [],
  "directories": {
    "doc": "docs"
  },
  "files": [
    "README.md",
    "COMMON_SPEC.md",
    "LICENSE"
  ],
  "scripts": {
    "lint:docs": "s2j-docs-linter ./README.md ./CHANGELOG.md ./docs/*.md ./docs/**/*.md",
    "lint:swift": "npm run lint:swiftlint && npm run lint:swiftformat && npm run lint:periphery",
    "lint:swiftlint": "swiftlint lint --strict Sources Tests CozyBrewApp Package.swift",
    "lint:swiftformat": "swiftformat --lint .",
    "lint:periphery": "periphery scan --strict",
    "format:swift": "swiftformat .",
    "profile:swift": "xcrun xctrace",
    "lint:build": "xcodebuild build -project CozyBrew.xcodeproj -scheme CozyBrewApp -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO",
    "analyze:swift": "xcodebuild analyze -project CozyBrew.xcodeproj -scheme CozyBrewApp -destination 'platform=macOS' CODE_SIGNING_ALLOWED=NO",
    "swift:ncu": "./scripts/swift-deps.sh check",
    "swift:ncu:update": "./scripts/swift-deps.sh update",
    "swift:install": "./scripts/swift-deps.sh install",
    "swift:update": "swift package update",
    "swift:resolve": "swift package resolve",
    "swift:show-deps": "swift package show-dependencies",
    "test:local": "./scripts/test-local.sh",
    "test:local:macOS": "./scripts/test-local_macOS.sh",
    "test:local:iOSfull": "./scripts/test-local.sh --ios-device \"iPad Pro\" --ios-version \"15.0\" --enable-xcode-project --xcodegen-auto-install",
    "ack:doctor": "s2j-acknowledgements doctor --config ack.config.json",
    "ack:generate": "s2j-acknowledgements generate --config ack.config.json"
  },
  "devDependencies": {
    "@s2j/acknowledgements": "^0.1.12",
    "@s2j/docs-linter": "^1.0.32"
  },
  "allowScripts": {
    "@s2j/docs-linter": true
  },
  "overrides": {
    "glob": "^14.0.3",
    "minimatch": "^11.0.4"
  }
}
